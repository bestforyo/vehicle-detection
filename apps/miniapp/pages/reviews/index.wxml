<view class="page">
  <view class="heading">
    <text class="eyebrow">ORGANIZATION · QUALITY REVIEW</text>
    <text class="title">机构审核</text>
    <text class="muted">检查检测师提交的结果和现场证据，再选择通过或退回修改。</text>
  </view>
  <view wx:if="{{unauthorized}}" class="error">此功能仅向机构管理员开放。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="empty">正在加载待审核记录…</view>
  <view wx:elif="{{!unauthorized && !reviews.length}}" class="card empty">
    <text class="card-title">当前没有待审核记录</text>
    <text class="muted">检测师提交检测后，记录会出现在此队列。</text>
  </view>
  <view wx:for="{{reviews}}" wx:key="id" class="review-card" data-index="{{index}}" bindtap="openReview">
    <view class="row">
      <text class="review-title">{{item.vehicleLabel || "车辆检测"}}</text>
      <text class="status">{{item.statusLabel}}</text>
    </view>
    <text class="review-subtitle">{{item.template.title}} · {{item.template.standardType}}</text>
    <text class="small">{{item.orderNo}}　{{item.vehicle.plate || "未填写车牌"}}</text>
    <text class="small">检测师：{{item.inspector.displayName}}　·　提交修订版 {{item.revision.revisionNumber}}</text>
  </view>
</view>
