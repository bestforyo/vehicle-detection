.eyebrow {
  color: #8ca09a;
  display: block;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  margin: 16rpx 0 12rpx;
}

.subtitle {
  display: block;
  margin: 10rpx 0 24rpx;
}

.empty {
  line-height: 1.8;
}

.template-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.template-standard {
  color: #62806d;
  font-size: 22rpx;
}

.card-title {
  color: #344a40;
  display: block;
  font-size: 30rpx;
  font-weight: 650;
}

.small {
  color: #95a19b;
  font-size: 22rpx;
}

.standard-picker {
  margin: 14rpx 0;
}

.approval-form {
  border-top: 1rpx solid #edf1ee;
  margin-top: 18rpx;
  padding-top: 16rpx;
}

.field-label {
  color: #576860;
  display: block;
  font-size: 23rpx;
  font-weight: 600;
  margin: 14rpx 0 8rpx;
}

.textarea {
  background: #fff;
  border: 1rpx solid #dfe7e2;
  border-radius: 12rpx;
  box-sizing: border-box;
  min-height: 150rpx;
  padding: 18rpx;
  width: 100%;
}
