.heading {
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.heading .title,
.heading .muted {
  display: block;
}

.heading .title {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.eyebrow {
  color: #8ca09a;
  display: block;
  font-size: 19rpx;
  margin-bottom: 10rpx;
}

.status {
  background: #edf3fa;
  border-radius: 30rpx;
  color: #53738d;
  flex: none;
  font-size: 20rpx;
  padding: 8rpx 12rpx;
}

.section-picker,
.result-picker {
  margin: 20rpx 0;
}

.section-guidance,
.guidance {
  display: block;
  margin: 10rpx 2rpx;
}

.item-card {
  background: #fff;
  border: 1rpx solid #e5ebe7;
  border-radius: 16rpx;
  margin: 16rpx 0;
  padding: 24rpx;
}

.item-heading {
  justify-content: flex-start;
  margin-bottom: 10rpx;
}

.item-title {
  color: #354840;
  font-size: 27rpx;
  font-weight: 650;
}

.required {
  background: #faf2e4;
  border-radius: 6rpx;
  color: #a17637;
  font-size: 19rpx;
  padding: 4rpx 8rpx;
}

.textarea {
  background: #fff;
  border: 1rpx solid #dfe7e2;
  border-radius: 12rpx;
  box-sizing: border-box;
  min-height: 140rpx;
  padding: 18rpx;
  width: 100%;
}

.evidence {
  border-top: 1rpx solid #edf1ee;
  margin-top: 18rpx;
  padding-top: 18rpx;
}

.photo-button {
  font-size: 23rpx;
  margin: 14rpx 0 0;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.photo-chip {
  background: #edf5ef;
  border-radius: 8rpx;
  color: #50745b;
  font-size: 20rpx;
  padding: 10rpx 14rpx;
}

.pager {
  gap: 8rpx;
  margin: 24rpx 0 120rpx;
}

.pager button {
  flex: 1;
  font-size: 22rpx;
  padding-left: 8rpx;
  padding-right: 8rpx;
}

.pager .small {
  flex: none;
}

.save-bar {
  background: #fff;
  border-top: 1rpx solid #e1e9e3;
  bottom: 0;
  display: flex;
  gap: 14rpx;
  left: 0;
  padding: 14rpx 24rpx env(safe-area-inset-bottom);
  position: fixed;
  right: 0;
}

.save-bar button {
  flex: 1;
  font-size: 24rpx;
  margin: 0;
}

.review-note {
  background: #fff7eb;
  border-color: #f0dfc3;
}

.review-title {
  color: #80643e;
  display: block;
  font-size: 25rpx;
  font-weight: 650;
  margin-bottom: 10rpx;
}

.info {
  background: #eef4f3;
  color: #5d7470;
  font-size: 23rpx;
  line-height: 1.6;
}
